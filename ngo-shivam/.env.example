# Copy this file to .env.local (local) and add the same values in your hosting
# panel's Environment Variables. Never commit the real password.

# Hostinger mailbox that SENDS the emails
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@roottechnology.in
SMTP_PASS=put-the-mailbox-password-here

# Inbox that RECEIVES every form submission (the NGO / management team)
MAIL_TO=ngoshivam@gmail.com

# Optional: sender display name
MAIL_FROM_NAME=NGO Shivam Website

# ---- SEO ----------------------------------------------------------------
# Your live website address, with https:// and without a trailing slash.
# Used for canonical URLs, sitemap.xml, robots.txt and social-share links.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.org

# Optional: paste the verification codes from Google Search Console / Bing Webmaster Tools
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ---- Admin panel (MongoDB + authentication) -----------------------------
# MongoDB connection string. Use a dedicated database user with read/write
# access to MONGODB_DB only. Never commit the real value.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=ngo_shivam

# Secret used to sign admin session tokens. Must be at least 32 random
# characters. Generate one with:  openssl rand -base64 48
AUTH_SECRET=put-a-long-random-secret-here

# One-time bootstrap secret that allows creating the FIRST Super Admin.
# It stops working as soon as a Super Admin exists. Generate with:
#   openssl rand -hex 32
SETUP_TOKEN=put-a-one-time-setup-token-here

# Initial signup PIN (digits only). It is hashed and stored in MongoDB the first
# time the app needs it; after that the Super Admin changes it through
# PUT /api/admin/settings/signup-pin. Leave empty to keep signup closed until a
# PIN is set.
SIGNUP_PIN_INITIAL=

# Set to true ONLY when the app runs behind a reverse proxy / CDN that overwrites
# X-Forwarded-For (Hostinger, Vercel, Cloudflare, nginx). Used to find the client IP
# for login rate limiting. Leave unset when the app is exposed directly.
TRUST_PROXY=
